# InfinityPay merchant app — build-time configuration.
#
# Copy to .env and fill in. Never commit .env (it is gitignored).
#
# ---------------------------------------------------------------------------
# Read this before adding anything
# ---------------------------------------------------------------------------
#
# Expo compiles every EXPO_PUBLIC_* variable into the app bundle as a
# literal string. Anyone who installs the app can read them with a text
# editor. There is no such thing as a secret in this file.
#
# A variable belongs here only if publishing it changes nothing:
#
#   - the Supabase anon key is designed to be public; Row Level Security
#     and the API's own ownership checks are what protect data, not the
#     key's secrecy
#   - the API base URL is a hostname
#
# Everything that actually protects money stays on the backend — Railway
# environment variables for the API, never here, never in app.json, never
# in eas.json. Both of those files ship inside the bundle too.
#
# NEVER put any of these in this file, in app.json, in eas.json, or in any
# EXPO_PUBLIC_* variable:
#
#   - SUPABASE_SERVICE_ROLE_KEY        (full database access, bypasses RLS)
#   - SELCOM_CHECKOUT_* / SELCOM_BUSINESS_* / any Selcom credential
#   - RESEND_API_KEY
#   - SENTRY_AUTH_TOKEN                (source-map upload; CI only)
#   - POSTHOG_PERSONAL_API_KEY
#   - DATABASE_URL
#   - JWT_SECRET / any token-signing secret
#   - webhook signing secrets (whsec_...)
#   - merchant API secret keys (sk_live_..., sk_test_...)
#
# If a value's name contains SECRET, PRIVATE, TOKEN, PASSWORD or
# SERVICE_ROLE, it does not go in this app.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# The InfinityPay API. Use your machine's LAN address, not localhost, when
# running on a physical device — on the phone, localhost is the phone.
# Production builds must point at the production API over HTTPS.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# Same Supabase project as the web portal. The anon (publishable) key,
# never the service role key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Not wired up yet
# ---------------------------------------------------------------------------
#
# The API and the web portal have Sentry and PostHog; this app does not.
# Nothing reads the variables below, so setting them has no effect. They
# are listed so that whoever adds the SDKs uses these names, and knows
# that only the public DSN/key goes here — a Sentry auth token (used to
# upload source maps) is a CI secret and must never be bundled.
#
# EXPO_PUBLIC_SENTRY_DSN=
# EXPO_PUBLIC_SENTRY_ENVIRONMENT=production
# EXPO_PUBLIC_POSTHOG_KEY=
# EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
