ENVIRONMENT=development

# INFO (default) or DEBUG/WARNING/ERROR — sets the level for every
# "infinity.*"-named logger in this app (see app/main.py::_configure_logging).
# Without this, before it existed, nothing configured Python's logging
# system at all, so every logger.info() call was silently dropped in
# production — only .warning()/.error()/.exception() calls were ever
# visible in Railway logs. Leave at INFO in production; DEBUG is noisy
# but occasionally useful for local troubleshooting.
LOG_LEVEL=INFO

# =============================================================================
# REQUIRED — the backend won't authenticate or reach Supabase without these.
# =============================================================================

# Project URL and service_role key (Project Settings -> API). service_role
# bypasses RLS — server-only, NEVER expose it to apps/web or any frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# JWKS verification (Project Settings -> API -> JWT Keys -> "JWT Signing
# Keys" tab) — the CURRENT, preferred way this backend verifies Supabase
# Auth access tokens (asymmetric ES256/RS256, checked against the project's
# published signing key, no shared secret involved). See app/auth/jwt.py.
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1

# CORS — origins allowed to call this API. Note: the code reads
# CORS_ORIGINS specifically — "FRONTEND_ORIGINS" is not a recognized
# variable name for this and has no effect if set instead. Accepts either a
# JSON array (CORS_ORIGINS=["https://infinitypay.me"]) or a plain
# comma-separated list (CORS_ORIGINS=https://a.com,https://b.com) — use
# whichever is easier to type correctly in Railway's env var UI. Never "*"
# outside ENVIRONMENT=development — the backend sets allow_credentials=True,
# and a wildcard origin combined with credentials is both browser-rejected
# and a real security hole; app/config/settings.py refuses to boot with one
# set outside development.
#
# Local dev default below. Production (Railway) example — replace with the
# real deployed frontend origin(s):
# CORS_ORIGINS=["https://infinitypay.me","https://www.infinitypay.me","https://<vercel-preview-url>.vercel.app"]
CORS_ORIGINS=["http://localhost:3000"]

# Base URL of apps/web — used to build the public payment-link checkout URL
# (public_slug -> {PUBLIC_APP_URL}/pay/{public_slug}). Note: the code reads
# PUBLIC_APP_URL specifically — "PUBLIC_WEB_URL" is not a recognized
# variable name for this and has no effect if set instead.
# Local dev default below; production (Railway) uses https://infinitypay.me
PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# OPTIONAL / LEGACY / CURRENTLY UNUSED — safe to leave blank. Unknown env
# vars are silently ignored (pydantic-settings extra="ignore"), so leaving
# these blank is never a "missing required var" error.
# =============================================================================

# Legacy HS256 shared-secret JWT verification (Project Settings -> API ->
# JWT Keys -> "Legacy JWT Secret" tab). Only relevant for a Supabase project
# that still signs tokens with a shared secret instead of JWKS signing keys,
# or to keep verifying tokens issued before a JWKS rotation until they
# expire. JWKS (above) is tried first and should remain the preferred
# method — see app/auth/jwt.py for the fallback order.
SUPABASE_JWT_SECRET=

# Direct Postgres connection strings (Project Settings -> Database ->
# Connection String). NOT read by any code path today — this backend talks
# to Supabase exclusively over the REST API via supabase-py
# (SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY above), never a raw Postgres
# driver, Prisma, or an ORM. Only needed if a future direct-connection
# code path (raw SQL, SQLAlchemy, Prisma, etc.) is added.
DATABASE_URL=
DIRECT_URL=

# =============================================================================
# Application config
# =============================================================================

# Mock Selcom client (no live Selcom integration yet — see
# app/services/selcom/mock_client.py)
MOCK_PROVIDER_FAILURE_RATE=0.1
MOCK_PROVIDER_LATENCY_SECONDS=0.3
DYNAMIC_QR_EXPIRY_SECONDS=300

# Shared secret for verifying the (mock) HMAC signature on incoming
# POST /v1/webhooks/selcom deliveries
SELCOM_WEBHOOK_SECRET=

# =============================================================================
# Selcom production integration (Railway) — see docs/selcom-live-go-live.md
# for the full deploy/whitelist/go-live procedure. Leave every value below
# at its default (blank / false / mock) until Selcom has whitelisted this
# backend's Railway static outbound IP and issued live credentials. NEVER
# set these in apps/web/Vercel — Selcom credentials are backend-only.
# =============================================================================

# Selcom's API base URL — provided by Selcom for your account/environment.
SELCOM_BASE_URL=

# Live Selcom API credentials — issued by Selcom, backend/Railway env vars
# only, never committed, never sent to the frontend.
SELCOM_API_KEY=
SELCOM_API_SECRET=
SELCOM_VENDOR_ID=

# Feature flags — keep false until Selcom confirms IP whitelisting and the
# credentials above are live and verified.
SELCOM_COLLECTION_ENABLED=false
SELCOM_WITHDRAWAL_ENABLED=false

# Informational — the real webhook route is registered at this fixed path
# regardless of this value (app/main.py); documented here so it's easy to
# find when giving Selcom your callback URL (https://<railway-domain>
# + this path).
SELCOM_WEBHOOK_PATH=/v1/webhooks/selcom

# "mock" (default) = every collection/disbursement runs through
# MockSelcomClient — simulated responses only, no network call ever reaches
# Selcom (see app/services/selcom/client.py::get_selcom_client()). Set to
# "live" only after Selcom confirms IP whitelisting and the credentials
# above are verified working — see docs/selcom-live-go-live.md.
SELCOM_MODE=mock

# =============================================================================
# Selcom Business Disbursement API (developer.selcom.business) — the real,
# documented API withdrawals are approved against. A different Selcom
# product from SELCOM_* above (different base URLs, different RSA-SHA256
# signing scheme — see app/services/selcom_business/), so it gets its own
# variable namespace rather than reusing SELCOM_MODE/SELCOM_API_KEY/etc.
# Backend/Railway env vars only — NEVER set any of these in apps/web/Vercel.
# =============================================================================

# "mock" (local development only — never use in a deployed environment),
# "sandbox" (real calls to SELCOM_BUSINESS_SANDBOX_BASE_URL), or "live"
# (real calls to SELCOM_BUSINESS_PRODUCTION_BASE_URL). The default here is
# "sandbox", not "mock" — a real withdrawal approval must never silently
# no-op against a fake client. See docs/selcom-live-go-live.md before ever
# setting this to "live".
SELCOM_BUSINESS_MODE=sandbox

SELCOM_BUSINESS_SANDBOX_BASE_URL=https://sandbox.selcom.business
SELCOM_BUSINESS_PRODUCTION_BASE_URL=https://api.selcom.business/v1

# Issued by Selcom for your Business Disbursement API account.
SELCOM_BUSINESS_API_KEY=
# Base64-encoded PEM RSA private key used to sign every request
# (RSA-SHA256) — see app/services/selcom_business/signing.py. Never commit
# the actual key; this stays blank in version control.
SELCOM_BUSINESS_PRIVATE_KEY_BASE64=
SELCOM_BUSINESS_ACCOUNT_NUMBER=

SELCOM_BUSINESS_TIMEOUT_SECONDS=30
# Selcom whitelists by source IP for this API too — see
# docs/selcom-live-go-live.md's Railway Static Outbound IP procedure if a
# request comes back with error code 611 / HTTP 403.
SELCOM_BUSINESS_REQUIRE_IP_WHITELIST=false

# =============================================================================
# Selcom Checkout/Collections API (https://developers.selcommobile.com/) —
# the real, documented reference for USSD/STK/wallet push, Selcom Pesa
# push, and dynamic QR collections. Supersedes the earlier, unconfirmed
# SELCOM_* placeholder above (app/services/selcom/) — see
# app/services/selcom_checkout/. A different Selcom product/signing
# scheme from SELCOM_BUSINESS_* above too. Backend/Railway env vars only
# — NEVER set any of these in apps/web/Vercel.
# =============================================================================

SELCOM_CHECKOUT_MODE=mock
SELCOM_CHECKOUT_BASE_URL=
# Issued by Selcom for your Checkout API account.
SELCOM_CHECKOUT_API_KEY=
# HMAC secret used for HS256 signing — see app/services/selcom_checkout/signer.py.
SELCOM_CHECKOUT_API_SECRET=
# "HS256" or "RS256" — confirm with Selcom which your account requires.
SELCOM_CHECKOUT_DIGEST_METHOD=HS256
SELCOM_CHECKOUT_VENDOR=
SELCOM_CHECKOUT_TIMEOUT_SECONDS=30
# Only needed if Selcom confirms this account requires RS256 instead of
# HS256. Base64-encoded PEM RSA private key. Never commit the actual key.
SELCOM_CHECKOUT_PRIVATE_KEY_BASE64=
# Our own webhook callback URL, not a secret. Register this exact same
# URL with Selcom's Checkout callback configuration too — see
# docs/selcom-checkout-collections.md. Leave blank to send no webhook
# field at all (reconciliation still works via manual refresh).
SELCOM_CHECKOUT_WEBHOOK_URL=

# Confirmed 2026-08-27: Selcom's real Checkout webhook sends no signature
# at all, so it's rejected (401) in every environment except local
# development. LEAVE BLANK in Railway/production — this is the ONLY way
# to make the webhook accept an unsigned delivery, and it only works when
# ENVIRONMENT=development too (never in a deployed environment, by
# design — see app/config/settings.py). Local dev only: pair with the
# X-Internal-Test-Secret header on a manual test POST.
SELCOM_CHECKOUT_WEBHOOK_TEST_SECRET=

# Backend-initiated reconciliation sweep interval, in seconds — this,
# not the (permanently-rejecting) webhook, is what actually keeps
# merchant wallets credited for Selcom Checkout collections. 0 (default)
# disables it. Set to e.g. 120 in Railway to enable a real 2-minute
# sweep; leave at 0 for local dev/tests.
SELCOM_CHECKOUT_RECONCILE_INTERVAL_SECONDS=0

# Same idea, for withdrawals (app/services/disbursements.py::
# reconcile_pending_disbursements) — a safety net for a delayed/dropped
# disbursement webhook delivery, not compensating for a broken signature
# scheme (that webhook is signed and verified successfully, unlike
# checkout's). 0 (default) disables it. Set to e.g. 120 in Railway to
# enable a real 2-minute sweep; leave at 0 for local dev/tests.
SELCOM_DISBURSEMENT_RECONCILE_INTERVAL_SECONDS=0

# =============================================================================
# Transactional email (Resend) — see docs/email-delivery.md. Backend/Railway
# env vars only, NEVER set RESEND_API_KEY in apps/web/Vercel. Leave
# RESEND_API_KEY blank to leave email sending unconfigured — "send invoice"
# then fails with a clear error instead of silently not sending anything.
# =============================================================================

RESEND_API_KEY=
# Sender for every transactional email EXCEPT invoice payment requests.
EMAIL_FROM="InfinityPay <notification@infinitypay.me>"
# Sender for invoice payment-request emails specifically — falls back to
# EMAIL_FROM above when blank.
INVOICE_EMAIL_FROM="InfinityPay Invoices <invoice@infinitypay.me>"
# Reply-to for every transactional email — the customer/merchant support
# contact shown in every template's footer.
EMAIL_REPLY_TO=info@infinitypay.me
# Where internal notifications go: new "contact us" inquiries, new
# merchant signups, and withdrawal requests awaiting approval.
#
# Comma-separated for more than one recipient, e.g.
#   CEO_EMAIL=ceo@infinitypay.me,second.admin@example.com
#
# Being a Super Admin does NOT subscribe anyone to these -- an admin
# must be named here to receive them. Authorisation and notification are
# deliberately separate, so granting admin never silently starts mailing
# a new address.
CEO_EMAIL=ceo@infinitypay.me
# General site base URL for email templates — distinct from PUBLIC_APP_URL
# above (which specifically builds the /pay/{slug} link). Falls back to
# PUBLIC_APP_URL when blank.
APP_URL=https://infinitypay.me

# Platform economics
PLATFORM_FEE_PERCENTAGE=1.5

# Backend-controlled withdrawal amount guardrails for MVP launch —
# supersedes the old, temporary WITHDRAWAL_PILOT_MODE/
# WITHDRAWAL_PILOT_MAX_AMOUNT_TZS pilot cap (docs/withdrawal-production-pilot-checklist.md).
# The frontend never decides these; the backend rejects with a clear error
# if a request is outside them. These are the hard caps every withdrawal
# must fit under, auto-processed or manually approved alike — see the
# withdrawal automation block below.
MIN_WITHDRAWAL_AMOUNT_TZS=1000
MAX_WITHDRAWAL_AMOUNT_TZS=5000000
DAILY_WITHDRAWAL_LIMIT_TZS=10000000

# --- Withdrawal automation (off by default) ---------------------------------
# With the values below as-is, behavior is exactly the historical one:
# every withdrawal is created PENDING_ADMIN_APPROVAL and waits for a
# Super Admin. Automation only ever takes effect when BOTH
# REQUIRE_ADMIN_APPROVAL_FOR_ALL_WITHDRAWALS=false AND
# AUTO_WITHDRAWALS_ENABLED=true — deliberately two flags, so a single
# mistaken env var can never silently start paying out unattended.
# app/main.py logs a loud startup warning whenever automation is on.
# See docs/MVP_LAUNCH_CHECKLIST.md and
# app/services/disbursements.py::_evaluate_auto_withdrawal_eligibility.
REQUIRE_ADMIN_APPROVAL_FOR_ALL_WITHDRAWALS=true
AUTO_WITHDRAWALS_ENABLED=false
# Per-transaction ceiling for automatic processing. A request above this
# is never rejected — it just falls back to PENDING_ADMIN_APPROVAL.
AUTO_WITHDRAWAL_MAX_AMOUNT_TZS=500000
# Rolling 24h cap on what will be auto-processed per merchant. Exceeding
# it also only falls back to manual approval, never rejects.
AUTO_WITHDRAWAL_DAILY_LIMIT_TZS=1000000
# Documents an invariant, not a real switch: merchant verification is
# checked unconditionally on every withdrawal path. Setting this false
# cannot skip it.
AUTO_WITHDRAWAL_REQUIRE_APPROVED_MERCHANT=true

# --- Email volume controls --------------------------------------------------
# Each gates ONE category independently; all default false (the current
# reduced-volume state). Never gates email verification, password reset,
# staff invites, merchant approval, the CEO signup notification, or any
# security alert — those always send. Set any to true to restore that
# one category with no code change.
# Customer-facing "here's your receipt" email after a successful payment.
# The payment, the wallet credit and the in-portal receipt are unaffected.
SEND_CUSTOMER_RECEIPT_EMAILS=false
# CEO-facing "please review this withdrawal request" email. The request,
# its audit log and the Super Admin queue are unaffected.
SEND_WITHDRAWAL_REQUEST_EMAILS=false
# Merchant-facing "your withdrawal succeeded" email. The in-app
# notification and the outbound webhook are unaffected.
SEND_MERCHANT_WITHDRAWAL_EMAILS=false

# Production safety switches (Settings, "Production safety switches") —
# all default true. Flip any of these to false in Railway for an
# immediate pause on new requests, no redeploy needed; existing records
# always remain viewable. See docs/MVP_LAUNCH_CHECKLIST.md.
ENABLE_COLLECTIONS=true
ENABLE_WITHDRAWALS=true
ENABLE_MERCHANT_API_KEYS=true
ENABLE_AUTO_RECONCILIATION=true

# --- Request identity ---------------------------------------------------
# How many proxies of OUR OWN sit in front of this API, for reading
# X-Forwarded-For (app/core/request_ip.py). This decides which entry of
# that header is believed, and therefore whether a caller can choose their
# own IP -- which would let them rotate past every rate limit and present
# as an allowlisted address to a merchant's API-key IP allowlist.
#   0 = ignore the header entirely and use the socket peer (safest; start
#       here, then confirm api_keys.last_used_ip shows a real public IP)
#   1 = Railway's edge alone
#   2 = Cloudflare (or similar) in front of Railway
TRUSTED_PROXY_HOPS=0

# --- Super Admin MFA ----------------------------------------------------
# Mandatory TOTP for platform admins. When true, require_super_admin also
# demands a Supabase aal2 session and every /v1/admin route refuses a
# password-only admin with `mfa_required`.
#
# Keep false until BOTH admins have enrolled and each has completed a
# challenge -- turning it on first locks everyone out of approving
# withdrawals. Setting it back to false is the entire rollback.
#
# apps/web needs the SAME value (server-side only, never NEXT_PUBLIC_) so
# the portal routes admins to the MFA pages; the API is the authority.
# See docs/SUPER_ADMIN_MFA_RUNBOOK.md.
REQUIRE_SUPER_ADMIN_MFA=false

# --- Security alerts ----------------------------------------------------
# Email for the subset of audit events worth interrupting someone for:
# withdrawals approved/rejected, businesses approved/rejected, pricing
# changed, an admin blocked for missing MFA, a non-admin probing /v1/admin,
# and a live API key used from an unapproved IP.
#
# audit_logs remains the complete record regardless. Setting
# SECURITY_ALERTS_ENABLED=false silences the email only -- it never stops
# anything being audited.
SECURITY_ALERTS_ENABLED=true
# Falls back to the first CEO_EMAIL recipient when blank.
SECURITY_ALERT_EMAIL=
# Applies only to events one actor can trigger repeatedly (blocked admin
# retrying, rejected IP hammering an endpoint). Money decisions are never
# deduplicated -- each approval is its own email.
SECURITY_ALERT_DEDUPE_WINDOW_SECONDS=600
