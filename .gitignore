# --- Node / Next.js (apps/web, packages/shared) ---
node_modules/
.next/
out/
build/
dist/
*.tsbuildinfo
coverage/
.turbo/
.vercel/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Python / FastAPI (apps/api) ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Env files — everything except the committed .example templates ---
.env
.env.*
!.env.example
!*.env.example
apps/api/.env
apps/api/.env.*
!apps/api/.env.example
apps/web/.env.local
apps/web/.env.*
!apps/web/.env.example

# --- Deploy platforms ---
.railway/
turbo/
# Expo build/dev state. apps/mobile has its own .gitignore for this, but
# `expo export` run from the repo root would land here instead.
.expo/
.expo-shared/

# --- Secrets / private material ---
*.pem
*.key
*.p12
*.pfx
*.crt
*.csr
*.cer
*.jks
*.keystore
secrets/
private/
credentials/
service-account*.json
*-service-account.json
*.service-role*.json
uploads/

# --- Test / tooling artifacts ---
playwright-report/
test-results/
supabase/.temp/
supabase/.branches/

# Local database dumps. `supabase db dump` and pg_dump output carry real
# merchant rows, customer phone numbers and ledger history — everything
# supabase/migrations deliberately does not. Migrations themselves stay
# tracked; these patterns are narrow so they cannot swallow one.
*.dump
*.sql.gz
supabase/dumps/
supabase/*dump*.sql
db-dump*.sql

# Local-only seeded test-account credentials (real, if throwaway, passwords —
# never push to GitHub; see docs/test-accounts.md's own "Before going live"
# checklist).
docs/test-accounts.md

# --- Editors / OS ---
.vscode/
.idea/
.claude/
.DS_Store
Thumbs.db
*.log
