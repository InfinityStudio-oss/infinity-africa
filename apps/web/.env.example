# Base URL of the FastAPI backend (apps/api)
# Local dev default below. The actual live production backend is the
# Railway-generated URL (see Railway dashboard / `railway status`) until a
# custom domain is set up and DNS-verified. Whatever this var is actually
# set to in Vercel is also the exact URL that must be registered with
# Selcom as the Checkout webhook callback — see
# docs/selcom-checkout-collections.md.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public base URL of this site (apps/web) — used for links/metadata that need
# an absolute URL (e.g. OpenGraph, payment link previews)
# Local dev default below; production (Vercel) uses https://infinitypay.me
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Search Console site verification token (the content="..." value
# from the HTML-tag verification method). Public — it ships in the page
# HTML — but it identifies an account, so it is set per deployment in
# Vercel rather than committed. Leave blank locally; with no value the
# meta tag is omitted entirely. See docs/SEO_GOOGLE_INDEXING_CHECKLIST.md.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Supabase (public — safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Mandatory TOTP for platform admins. Must match REQUIRE_SUPER_ADMIN_MFA on
# the API service. Server-side only -- deliberately NOT NEXT_PUBLIC_, since
# this is a security posture the browser has no need of. The API enforces
# it regardless; this only decides whether the portal sends an admin to the
# MFA pages first. See docs/SUPER_ADMIN_MFA_RUNBOOK.md.
REQUIRE_SUPER_ADMIN_MFA=false

# --- Monitoring (docs/MONITORING_AND_OBSERVABILITY.md) ------------------
# Blank means off, for all of these. With no DSN and no PostHog key the
# SDKs never initialise, no requests are made, and the site behaves
# exactly as before. NEVER commit real values -- set them in Vercel.
#
# Note these are a SEPARATE Sentry project from the API's: a browser DSN
# is necessarily public (it ships in the bundle), so it must not be the
# same DSN the server uses.

# Browser error monitoring. Public by necessity. Adding a value here also
# adds Sentry's ingest origin to the site's Content-Security-Policy
# connect-src at build time (see next.config.ts) -- without that the SDK
# would initialise and have every event blocked by the browser.
NEXT_PUBLIC_SENTRY_DSN=
# Defaults to NODE_ENV when blank.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Server-side errors from the Next app itself (server components, route
# handlers, Server Actions). Falls back to NEXT_PUBLIC_SENTRY_DSN. This is
# the Next server, not the payments API -- that has its own SENTRY_DSN.
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# Product analytics. A PostHog project key is write-only and intended to
# be public, which is why this one is NEXT_PUBLIC_.
#
# Autocapture, session replay and automatic pageviews are all switched OFF
# in code and are not configurable here -- autocapture would record the
# text of whatever was clicked (a customer's phone number on a checkout
# page, a revealed API secret in the portal), and replay would record the
# screen during a payment. See src/components/providers/analytics-provider.tsx.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
