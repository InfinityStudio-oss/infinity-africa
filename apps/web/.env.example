# Base URL of the FastAPI backend (apps/api)
# Local dev default below. The actual live production backend is the
# Railway-generated URL (see Railway dashboard / `railway status`) until a
# custom domain is set up and DNS-verified. Whatever this var is actually
# set to in Vercel is also the exact URL that must be registered with
# Selcom as the Checkout webhook callback — see
# docs/selcom-checkout-collections.md.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public base URL of this site (apps/web) — used for links/metadata that need
# an absolute URL (e.g. OpenGraph, payment link previews)
# Local dev default below; production (Vercel) uses https://infinitypay.me
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (public — safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
