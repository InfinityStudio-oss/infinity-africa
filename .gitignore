# --- Node / Next.js (apps/web, packages/shared) ---
node_modules/
.next/
out/
build/
dist/
*.tsbuildinfo
coverage/
.turbo/
.vercel/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Python / FastAPI (apps/api) ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Env files — everything except the committed .example templates ---
.env
.env.*
!.env.example
!*.env.example
apps/api/.env
apps/api/.env.*
!apps/api/.env.example
apps/web/.env.local
apps/web/.env.*
!apps/web/.env.example

# --- Deploy platforms ---
.railway/
turbo/
# Expo build/dev state. apps/mobile has its own .gitignore for this, but
# `expo export` run from the repo root would land here instead.
.expo/
.expo-shared/

# --- Secrets / private material ---
*.pem
*.key
*.p12
*.pfx
*.crt
*.csr
*.cer
*.jks
*.keystore
secrets/
private/
credentials/
service-account*.json
*-service-account.json
*.service-role*.json
uploads/

# --- Test / tooling artifacts ---
playwright-report/
test-results/
supabase/.temp/
supabase/.branches/

# Local database dumps. `supabase db dump` and pg_dump output carry real
# merchant rows, customer phone numbers and ledger history — everything
# supabase/migrations deliberately does not. Migrations themselves stay
# tracked; these patterns are narrow so they cannot swallow one.
*.dump
*.sql.gz
supabase/dumps/
supabase/*dump*.sql
db-dump*.sql

# Local-only seeded test-account credentials (real, if throwaway, passwords —
# never push to GitHub; see docs/test-accounts.md's own "Before going live"
# checklist).
docs/test-accounts.md

# --- Editors / OS ---
.vscode/
.idea/
.claude/
.DS_Store
Thumbs.db
*.log

# --- Added 2026-10-20 after a security inspection found these uncovered ---

# Database exports. The existing rules caught db-dump*.sql and *.dump but
# not the names people actually type by hand. A dump of this database
# contains every merchant balance and ledger entry, and the repository is
# publicly readable, so this is the single worst thing that could land in
# it by accident.
*dump*.sql
*backup*.sql
*.sql.bz2
*.sql.zst

# Data exports. Nothing in this repository tracks a .csv, and the ones
# produced during support work are merchant and customer lists with phone
# numbers. If a genuine test fixture ever needs one, add it deliberately
# with: git add -f path/to/fixture.csv
*.csv

# Private inspection output. Security findings, incident notes and audit
# reports name unverified weaknesses and belong nowhere near a public
# repository - keep them in a private location outside the working tree.
.private/
security-inspection-*.md
security-report-*.md
*-audit-report.md
incident-*.md
