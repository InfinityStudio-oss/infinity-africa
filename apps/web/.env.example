# Base URL of the FastAPI backend (apps/api)
# Local dev default below. NOTE (2026-08-22): api.infinityafrica.net does
# NOT currently resolve (confirmed via nslookup — NXDOMAIN) despite being
# documented here previously. The actual live production backend is the
# Railway-generated URL (see Railway dashboard / `railway status`) until a
# custom domain is set up and DNS-verified. Whatever this var is actually
# set to in Vercel is also the exact URL that must be registered with
# Selcom as the Checkout webhook callback — see
# docs/selcom-checkout-collections.md.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public base URL of this site (apps/web) — used for links/metadata that need
# an absolute URL (e.g. OpenGraph, payment link previews)
# Local dev default below; production (Vercel) uses https://infinitypay.me
# — the platform's new primary domain (brand/domain migration from
# Infinity Africa/infinityafrica.net to InfinityPay/infinitypay.me; the old
# domain keeps working via a DNS/Vercel redirect during the transition —
# see docs/MVP_LAUNCH_CHECKLIST.md).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (public — safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
